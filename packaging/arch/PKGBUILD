pkgname=emacs-maak
pkgver=0.9.2
pkgrel=1
pkgdesc="Maak integration for Emacs"
arch=('any')
url="https://codeberg.org/jjba23/maak.el"
license=('GPL-3.0-or-later')
depends=('emacs')
makedepends=('emacs')
checkdepends=('emacs')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('286592a3a84d6124aac9df2a4d6fa57edd8f7eece7da770919d9e1b5d695f597')

build() {
  cd "$srcdir/maak.el"

  emacs -Q --batch -f batch-byte-compile maak.el
}

check() {
  cd "$srcdir/maak.el"

  emacs -Q --batch -L . -L test -l test/maak-test.el -f ert-run-tests-batch-and-exit
}

package() {
  cd "$srcdir/maak.el"

  install -Dm644 maak.el "$pkgdir/usr/share/emacs/site-lisp/maak.el"
  install -Dm644 maak.elc "$pkgdir/usr/share/emacs/site-lisp/maak.elc"

  install -Dm644 COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"
  install -Dm644 README.org "$pkgdir/usr/share/doc/$pkgname/README.org"
}
