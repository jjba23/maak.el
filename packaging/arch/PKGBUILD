# SPDX-License-Identifier: MIT

# Maintainer: Josep Bigorra <jjbigorra@gmail.com>
pkgname=emacs-maak
pkgver=0.10.0
pkgrel=1
pkgdesc="Maak integration for Emacs"
arch=('any')
url="https://github.com/jjba23/maak.el"
license=('MIT')
depends=('emacs')
makedepends=('emacs')
checkdepends=('emacs')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('220d468167b871376d2af3902ee99ba649141700fbe1c5d66d19c7b523bf8dcb')

build() {
  cd "$srcdir/maak.el"

  emacs -Q --batch -f batch-byte-compile maak.el
}

check() {
  cd "$srcdir/maak.el"

  emacs -Q --batch -L . -L test -l test/maak-test.el -f ert-run-tests-batch-and-exit
}

package() {
  cd "$srcdir/maak.el"

  install -Dm644 maak.el "$pkgdir/usr/share/emacs/site-lisp/maak.el"
  install -Dm644 maak.elc "$pkgdir/usr/share/emacs/site-lisp/maak.elc"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.org "$pkgdir/usr/share/doc/$pkgname/README.org"
}
