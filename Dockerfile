# syntax=docker/dockerfile:1.7

# maak-el

# SPDX-License-Identifier: MIT
# Copyright © Josep Bigorra <jjbigorra@gmail.com>

# Generated by gen_containers.py; keep in step with packaging/.

FROM opensuse/tumbleweed:latest AS builder

ARG VERSION=dev

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

WORKDIR /src

RUN --mount=type=cache,target=/var/cache/zypp \
    set -eu; \
    zypper --non-interactive refresh; \
    zypper --non-interactive install --no-recommends emacs; \
    zypper clean --all

COPY maak.el ./

RUN set -eu; \
    emacs -Q --batch -f batch-byte-compile "maak.el"

# ----------------------------------------------------------------------
# Runtime
# ----------------------------------------------------------------------

FROM opensuse/tumbleweed:latest AS runtime

ARG VERSION=dev

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

LABEL org.opencontainers.image.title="maak-el" \
      org.opencontainers.image.description="Maak integration for Emacs" \
      org.opencontainers.image.url="https://github.com/jjba23/maak.el" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.version="${VERSION}"

RUN --mount=type=cache,target=/var/cache/zypp \
    set -eu; \
    zypper --non-interactive refresh; \
    zypper --non-interactive install --no-recommends emacs; \
    zypper clean --all

COPY --from=builder /src/maak.el /usr/share/emacs/site-lisp/maak.el
COPY --from=builder /src/maak.elc /usr/share/emacs/site-lisp/maak.elc

ENTRYPOINT ["emacs"]
CMD ["-nw"]
